msgstr ""

# null
#: _CommonClinicalObservationAssertionValue@definition
msgid "**Definition:** The non-laboratory, non-DI (diagnostic imaging) coded observation if no value is also required to convey the full meaning of the observation. This may be a single concept code or a complex expression."
msgstr ""

# null
#: _CommonClinicalObservationResultValue
msgid "CommonClinicalObservationResultValue"
msgstr ""

