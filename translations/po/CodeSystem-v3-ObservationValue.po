#: _ObservationMeasureScoring
msgid "ObservationMeasureScoring"
msgstr ""

# null
#: _ObservationMeasureScoring@definition
msgid "Observation values used to indicate the type of scoring (e.g. proportion, ratio) used by a health quality measure."
msgstr ""

# null
#: COHORT
msgid "cohort measure scoring"
msgstr ""

# null
#: COHORT@definition
msgid "A measure in which either short-term cross-section or long-term longitudinal analysis is performed over a group of subjects defined by a set of common properties or defining characteristics (e.g., Male smokers between the ages of 40 and 50 years, exposure to treatment, exposure duration)."
msgstr ""

# null
#: CONTVAR
msgid "continuous variable measure scoring"
msgstr ""

# null
#: CONTVAR@definition
msgid "A measure score in which each individual value for the measure can fall anywhere along a continuous scale (e.g., mean time to thrombolytics which aggregates the time in minutes from a case presenting with chest pain to the time of administration of thrombolytics)."
msgstr ""

# null
#: PROPOR
msgid "proportion measure scoring"
msgstr ""

# null
#: PROPOR@definition
msgid "A score derived by dividing the number of cases that meet a criterion for quality (the numerator) by the number of eligible cases within a given time frame (the denominator) where the numerator cases are a subset of the denominator cases (e.g., percentage of eligible women with a mammogram performed in the last year)."
msgstr ""

# null
#: RATIO
msgid "ratio measure scoring"
msgstr ""

# null
#: RATIO@definition
msgid "A score that may have a value of zero or greater that is derived by dividing a count of one type of data by a count of another type of data (e.g., the number of patients with central lines who develop infection divided by the number of central line days)."
msgstr ""

# null
#: _ObservationMeasureType
msgid "ObservationMeasureType"
msgstr ""

# null
#: _ObservationMeasureType@definition
msgid "Observation values used to indicate what kind of health quality measure is used."
msgstr ""

# null
#: COMPOSITE
msgid "composite measure type"
msgstr ""

# null
#: COMPOSITE@definition
msgid "A measure that is composed from one or more other measures and indicates an overall summary of those measures."
msgstr ""

# null
#: EFFICIENCY
msgid "efficiency measure type"
msgstr ""

# null
#: EFFICIENCY@definition
msgid "A measure related to the efficiency of medical treatment."
msgstr ""

# null
#: EXPERIENCE
msgid "experience measure type"
msgstr ""

# null
#: EXPERIENCE@definition
msgid "A measure related to the level of patient engagement or patient experience of care."
msgstr ""

# null
#: OUTCOME
msgid "outcome measure type"
msgstr ""

# null
#: OUTCOME@definition
msgid "A measure that indicates the result of the performance (or non-performance) of a function or process."
msgstr ""

# null
#: INTERM-OM
msgid "intermediate outcome measure type"
msgstr ""

# null
#: INTERM-OM@definition
msgid "A measure that evaluates the change over time of a physiologic state observable that is associated with a specific long-term health outcome."
msgstr ""

# null
#: PRO-PM
msgid "patient reported outcome measure type"
msgstr ""

# null
#: PRO-PM@definition
msgid "A measure that is a comparison of patient reported outcomes for a single or multiple patients collected via an instrument specifically designed to obtain input directly from patients."
msgstr ""

# null
#: PROCESS
msgid "process measure type"
msgstr ""

# null
#: PROCESS@definition
msgid "A measure which focuses on a process which leads to a certain outcome, meaning that a scientific basis exists for believing that the process, when executed well, will increase the probability of achieving a desired outcome."
msgstr ""

# null
#: APPROPRIATE
msgid "appropriate use process measure"
msgstr ""

# null
#: APPROPRIATE@definition
msgid "A measure that assesses the use of one or more processes where the expected health benefit exceeds the expected negative consequences."
msgstr ""

# null
#: RESOURCE
msgid "resource use measure type"
msgstr ""

# null
#: RESOURCE@definition
msgid "A measure related to the extent of use of clinical resources or cost of care."
msgstr ""

# null
#: STRUCTURE
msgid "structure measure type"
msgstr ""

# null
#: STRUCTURE@definition
msgid "A measure related to the structure of patient care."
msgstr ""

