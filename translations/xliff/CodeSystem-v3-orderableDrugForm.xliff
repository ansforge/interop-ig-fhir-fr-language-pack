        <target></target>
      </trans-unit>
      <trans-unit id="CodeSystem-v3-orderableDrugForm" resname="_LiquidLiquidEmulsion@definition">
        <source>A two-phase system in which one liquid is dispersed throughout another liquid in the form of small droplets.</source>
