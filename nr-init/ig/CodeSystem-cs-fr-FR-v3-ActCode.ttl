     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"fr-FR\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"fr-FR\"><p class=\"res-header-id\"><b>Narratif généré : CodeSystem cs-fr-FR-v3-ActCode</b></p><a name=\"cs-fr-FR-v3-ActCode\"> </a><a name=\"hccs-fr-FR-v3-ActCode\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Langue : fr-FR</p></div><p>This code system supplement <code>https://interop.esante.gouv.fr/ig/fhir/fr/CodeSystem/cs-fr-FR-v3-ActCode</code> defines fonctionnalités on the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Affichage</b></td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-AMB\">AMB</a><a name=\"cs-fr-FR-v3-ActCode-AMB\"> </a></td><td>Ambulatoire (hors établissement)</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-EMER\">EMER</a><a name=\"cs-fr-FR-v3-ActCode-EMER\"> </a></td><td>Passage aux urgences (établissement)</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-FLD\">FLD</a><a name=\"cs-fr-FR-v3-ActCode-FLD\"> </a></td><td>Terrain (voie publique, hélicoptère, ambulance, etc.)</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-HH\">HH</a><a name=\"cs-fr-FR-v3-ActCode-HH\"> </a></td><td>Soins à domicile (hors établissement)</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-IMP\">IMP</a><a name=\"cs-fr-FR-v3-ActCode-IMP\"> </a></td><td>Hospitalisation (établissement, y compris HAD)</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-OBSENC\">OBSENC</a><a name=\"cs-fr-FR-v3-ActCode-OBSENC\"> </a></td><td>Observation</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-PRENC\">PRENC</a><a name=\"cs-fr-FR-v3-ActCode-PRENC\"> </a></td><td>Pré-admission</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-SS\">SS</a><a name=\"cs-fr-FR-v3-ActCode-SS\"> </a></td><td>Hospitalisation de jour</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-VR\">VR</a><a name=\"cs-fr-FR-v3-ActCode-VR\"> </a></td><td>Virtuelle (exemple : RCP en l'absence du patient)</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-CIRCLE\">CIRCLE</a><a name=\"cs-fr-FR-v3-ActCode-CIRCLE\"> </a></td><td>Cercle</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-ELLIPSE\">ELLIPSE</a><a name=\"cs-fr-FR-v3-ActCode-ELLIPSE\"> </a></td><td>Elipse</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-POINT\">POINT</a><a name=\"cs-fr-FR-v3-ActCode-POINT\"> </a></td><td>Point</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-POLY\">POLY</a><a name=\"cs-fr-FR-v3-ActCode-POLY\"> </a></td><td>Multi</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-DRUG\">DRUG</a><a name=\"cs-fr-FR-v3-ActCode-DRUG\"> </a></td><td>Médicament</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-FD\">FD</a><a name=\"cs-fr-FR-v3-ActCode-FD\"> </a></td><td>Aliment</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-BOOSTER\">BOOSTER</a><a name=\"cs-fr-FR-v3-ActCode-BOOSTER\"> </a></td><td>Rappel de vaccin</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-IMMUNIZ\">IMMUNIZ</a><a name=\"cs-fr-FR-v3-ActCode-IMMUNIZ\"> </a></td><td>Vaccination sans autre précision</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-INITIMMUNIZ\">INITIMMUNIZ</a><a name=\"cs-fr-FR-v3-ActCode-INITIMMUNIZ\"> </a></td><td>1ère série vaccinante</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-SEV\">SEV</a><a name=\"cs-fr-FR-v3-ActCode-SEV\"> </a></td><td>Sévérité</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-FFC\">FFC</a><a name=\"cs-fr-FR-v3-ActCode-FFC\"> </a></td><td>Première dispensation - complète</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-FFP\">FFP</a><a name=\"cs-fr-FR-v3-ActCode-FFP\"> </a></td><td>Première dispensation - partielle</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-RFP\">RFP</a><a name=\"cs-fr-FR-v3-ActCode-RFP\"> </a></td><td>Dispensation suivante - partielle</td></tr><tr><td><a style=\"white-space:nowrap\" href=\"http://terminology.hl7.org/7.0.1/CodeSystem-v3-ActCode.html#v3-ActCode-RFC\">RFC</a><a name=\"cs-fr-FR-v3-ActCode-RFC\"> </a></td><td>Dispensation suivante - complète</td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
