# en -> fr

#: aborted
msgid "aborted"
msgstr "Arrêté (après son lancement)"

#: aborted@definition
msgid "The Act has been terminated prior to the originally intended completion."
msgstr ""

#: active
msgid "active"
msgstr "Actif (en cours ou à venir)"

#: active@definition
msgid "The Act can be performed or is being performed"
msgstr ""

#: cancelled
msgid "cancelled"
msgstr "Annulé (avant son lancement)"

#: cancelled@definition
msgid "The Act has been abandoned before activation."
msgstr ""

#: completed
msgid "completed"
msgstr "Terminé"

#: completed@definition
msgid "An Act that has terminated normally after all of its constituents have been performed."
msgstr ""

#: held
msgid "held"
msgstr "En attente (avant son lancement)"

#: held@definition
msgid "An Act that is still in the preparatory stages has been put aside. No action can occur until the Act is released."
msgstr ""

#: new
msgid "new"
msgstr "En préparation"

#: new@definition
msgid "An Act that is in the preparatory stages and may not yet be acted upon"
msgstr ""

#: suspended
msgid "suspended"
msgstr "Suspendu (au cours de sa réalisation)"

#: suspended@definition
msgid "An Act that has been activated (actions could or have been performed against it), but has been temporarily disabled. No further action should be taken against it until it is released"
msgstr ""
