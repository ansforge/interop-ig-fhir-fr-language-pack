# en -> fr

#: DS
msgid "daytime shift"
msgstr "Journée (par exemple : entre 6h et 18h)"

#: DS@definition
msgid "A person who is scheduled for work during daytime hours (for example between 6am and 6pm) on a regular basis."
msgstr ""

#: EMS
msgid "early morning shift"
msgstr "Matin (entre 2h et 14h)"

#: EMS@definition
msgid "Consistent Early morning schedule of 13 hours or less per shift (between 2 am and 2 pm)"
msgstr ""

#: ES
msgid "evening shift"
msgstr "Après-midi (entre 14h et minuit)"

#: ES@definition
msgid "A person who is scheduled for work during evening hours (for example between 2pm and midnight) on a regular basis."
msgstr ""

#: NS
msgid "night shift"
msgstr "Nuit (entre 21h et 8h)"

#: NS@definition
msgid "Scheduled for work during nighttime hours (for example between 9pm and 8am) on a regular basis."
msgstr ""

#: RSWN
msgid "rotating shift with nights"
msgstr "Variable (journées, soirées, avec parfois des nuits)"

#: RSWN@definition
msgid "Scheduled for work times that change periodically between days, and/or evenings, and includes some night shifts."
msgstr ""

#: RSWON
msgid "rotating shift without nights"
msgstr "Variable (journées, soirées, sans nuits ni soirées)"

#: RSWON@definition
msgid "Scheduled for work days/times that change periodically between days, but does not include night or evening work."
msgstr ""

#: SS
msgid "split shift"
msgstr "Journée avec coupure de 2 à 4 heures."

#: SS@definition
msgid "Shift consisting of two distinct work periods each day that are separated by a break of a few hours (for example 2 to 4 hours)"
msgstr ""

#: VLS
msgid "very long shift"
msgstr "Horaires de longue durée (17h ou plus)"

#: VLS@definition
msgid "Shifts of 17 or more hours."
msgstr ""

#: VS
msgid "variable shift"
msgstr "Irrégulier avec information à court terme"

#: VS@definition
msgid "Irregular, unpredictable hours scheduled on a short notice (for example, less than 2 day notice): inconsistent schedule, on-call, as needed, as available."
msgstr ""

#: Employed
msgid "Employed"
msgstr "En activité"

#: Employed@definition
msgid "Individuals who, during the last week: a) did any work for at least 1 hour as paid or unpaid employees of a business or government organization; worked in their own businesses, professions, or on their own farms; or b) were not working, but who have a job or business from which the individual was temporarily absent because of vacation, illness, bad weather, childcare problems, maternity or paternity leave, labor-management dispute, job training, or other family or personal reasons, regardless of whether or not they were paid for the time off or were seeking other jobs."
msgstr ""

#: NotInLaborForce
msgid "Not In Labor Force"
msgstr "Inactif"

#: NotInLaborForce@definition
msgid "Persons not classified as employed or unemployed, meaning those who have no job and are not looking for one."
msgstr ""

#: Unemployed
msgid "Unemployed"
msgstr "Sans activité"

#: Unemployed@definition
msgid "Persons who currently have no employment, but are available for work and have made specific efforts to find employment."
msgstr ""
