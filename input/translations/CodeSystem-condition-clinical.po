# en -> fr

#: active
msgid "Active"
msgstr "Actif"

#: active@definition
msgid "The subject is currently experiencing the condition or situation, there is evidence of the condition or situation, or considered to be a significant risk."
msgstr ""

#: recurrence
msgid "Recurrence"
msgstr "Récurrent"

#: recurrence@definition
msgid "The subject is experiencing a reoccurence or repeating of a previously resolved condition or situation, e.g. urinary tract infection, food insecurity."
msgstr ""

#: relapse
msgid "Relapse"
msgstr "Rechute"

#: relapse@definition
msgid "The subject is experiencing a return of a condition or situation after a period of improvement or remission, e.g. relapse of cancer, alcoholism."
msgstr ""

#: inactive
msgid "Inactive"
msgstr "Inactif"

#: inactive@definition
msgid "The subject is no longer experiencing the condition or situation and there is no longer evidence or appreciable risk of the condition or situation."
msgstr ""

#: remission
msgid "Remission"
msgstr "En rémission"

#: remission@definition
msgid "The subject is not presently experiencing the condition or situation, but there is a risk of the condition or situation returning."
msgstr ""

#: resolved
msgid "Resolved"
msgstr "Résolu"

#: resolved@definition
msgid "The subject is not presently experiencing the condition or situation and there is a negligible perceived risk of the condition or situation returning."
msgstr ""
