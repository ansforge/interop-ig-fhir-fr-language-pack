# en -> sv

#: unconfirmed
msgid "Unconfirmed"
msgstr "Obekräftad"

#: unconfirmed@definition
msgid "There is not sufficient evidence to assert the presence of the subject's condition."
msgstr "Det finns inte tillräckligt med bevis för att fastställa förekomsten av patientens tillstånd."

#: provisional
msgid "Provisional"
msgstr "Preliminär"

#: provisional@definition
msgid "This is a tentative diagnosis - still a candidate that is under consideration."
msgstr "Detta är en preliminär diagnos - fortfarande ett alternativ som övervägs."

#: differential
msgid "Differential"
msgstr "Differential"

#: differential@definition
msgid "One of a set of potential (and typically mutually exclusive) diagnoses asserted to further guide the diagnostic process and preliminary treatment."
msgstr "En av en uppsättning potentiella (och vanligtvis ömsesidigt uteslutande) diagnoser som anges för att ytterligare vägleda den diagnostiska processen och preliminär behandling."

#: confirmed
msgid "Confirmed"
msgstr "Bekräftad"

#: confirmed@definition
msgid "There is sufficient evidence to assert the presence of the subject's condition."
msgstr "Det finns tillräckligt med bevis för att fastställa förekomsten av patientens tillstånd."

#: refuted
msgid "Refuted"
msgstr "Motbevisad"

#: refuted@definition
msgid "This condition has been ruled out by subsequent diagnostic and clinical evidence."
msgstr "Detta tillstånd har uteslutits av efterföljande diagnostiska och kliniska bevis."

#: entered-in-error
msgid "Entered in Error"
msgstr "Felaktigt inmatad"

#: entered-in-error@definition
msgid "The statement was entered in error and is not valid."
msgstr "Uttalandet matades in felaktigt och är inte giltigt."
